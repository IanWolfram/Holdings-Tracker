# E*Trade
# Get your consumer key/secret from developer.etrade.com
# Run `npm run etrade:auth` once to complete the OAuth flow and get the tokens below.
# Note: Access tokens expire daily at midnight ET — re-run auth each morning.
ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=
ETRADE_OAUTH_TOKEN=
ETRADE_OAUTH_TOKEN_SECRET=
ETRADE_ENV=sandbox  # Use "sandbox" for testing, "live" for real data, "mock" to skip auth entirely

# Finnhub
FINNHUB_API_KEY=

# Twitter/X
TWITTER_BEARER_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b

# Stitch MCP
STITCH_API_KEY=

# OpenClaw
OPENCLAW_DIGEST_SECRET=

# Vercel (set after deploy)
DASHBOARD_URL=
