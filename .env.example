# E*Trade
# Get your consumer key/secret from developer.etrade.com
# Run `npm run etrade:auth` once to complete the OAuth flow and get the tokens below.
# Note: Access tokens expire daily at midnight ET — re-run auth each morning.
ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=
ETRADE_OAUTH_TOKEN=
ETRADE_OAUTH_TOKEN_SECRET=
ETRADE_ENV=sandbox  # Use "sandbox" for testing, "live" for real data, "mock" to skip auth entirely

# Finnhub
FINNHUB_API_KEY=

# Twitter/X
TWITTER_BEARER_TOKEN=

# NewsAPI (https://newsapi.org) — free tier: 100 req/day, dev use only
NEWSAPI_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_ENABLED=false

# Stitch MCP
STITCH_API_KEY=


# Vercel (set after deploy)
DASHBOARD_URL=

# World-Brain — Obsidian vault path (relative to project root or absolute)
WORLD_VAULT_PATH=./world-vault

# Background Services
WORLD_SYNC_ENABLED=true
WORLD_CRON_SCHEDULE=0 6-23 * * *
