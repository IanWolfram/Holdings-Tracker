# SnapTrade — brokerage aggregation (E*TRADE, Schwab, etc.)
# Credentials normally live in the Supabase `app_secrets` table; set here only
# for local overrides. Get them from the SnapTrade dashboard.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Finnhub
FINNHUB_API_KEY=

# NewsAPI (https://newsapi.org) — free tier: 100 req/day, dev use only
NEWSAPI_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_ENABLED=false

# Stitch MCP
STITCH_API_KEY=


# Vercel (set after deploy)
DASHBOARD_URL=

# World-Brain — Obsidian vault path (relative to project root or absolute)
WORLD_VAULT_PATH=./world-vault

# Background Services
WORLD_SYNC_ENABLED=true
WORLD_CRON_SCHEDULE=0 6-23 * * *

# Supabase (multi-tenant auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, never bundled to client

# Secret encryption key (32-byte hex for AES-256-GCM) — seals SnapTrade user
# secrets at rest. Keeps its historical ETRADE_ name; `…_KEYS` (comma-separated)
# supports rotation by key version.
ETRADE_TOKEN_ENC_KEY=

# Sentry error monitoring (optional — SDK stays disabled if no DSN).
# SENTRY_DSN lives in the Supabase `app_secrets` table (single source of truth),
#   hydrated into process.env at boot. The server reads it directly; the browser
#   SDK gets it at runtime via the root layout (components/providers/
#   SentryClientInit.tsx) — so it does NOT need to be here.
#   Caveat: the Edge runtime (middleware) can't read app_secrets; set SENTRY_DSN
#   in real env below only if you want edge errors reported too.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=   # optional build-time fallback for the browser SDK
# Build-time source-map upload (optional; org/project default in next.config.ts).
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN belongs in .env.sentry-build-plugin (gitignored), not here.

