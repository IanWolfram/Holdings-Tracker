{
  "name": "holdings-tracker",
  "version": "0.1.0",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron:dev": "concurrently \"next dev -p 3571\" \"wait-on http://localhost:3571 && electron .\"",
    "electron:build": "next build && electron-builder -c electron-builder.config.js",
    "lint": "eslint . --max-warnings=50",
    "world:refresh": "node scripts/world-refresh.mjs",
    "agent": "npx tsx scripts/agent.ts",
    "backfill": "npx tsx scripts/backfill-calibration.ts",
    "world:graph": "npx tsx scripts/world-graph.ts",
    "backfill:news-catalysts": "npx tsx scripts/backfill-news-catalysts.ts",
    "recalibrate": "npx tsx scripts/recalibrate.ts",
    "compare:forecasters": "npx tsx scripts/compare-forecaster-versions.ts",
    "congress:ingest": "npx tsx --env-file=.env.local scripts/ingest-congress.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop pulse",
    "pm2:restart": "pm2 restart pulse",
    "pm2:logs": "pm2 logs pulse",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.57.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "autoprefixer": "^10.4.27",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^5.8.0",
    "fflate": "^0.8.3",
    "framer-motion": "^12.38.0",
    "next": "^16.2.3",
    "node-cron": "^4.2.1",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "snaptrade-typescript-sdk": "^10.0.9",
    "swr": "^2.4.1",
    "tailwindcss": "^4.2.2",
    "three": "^0.183.2",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint-plugin-react-hooks": "^7.1.0",
    "pg": "^8.20.0",
    "typescript-eslint": "^8.58.2",
    "wait-on": "^9.0.5"
  }
}
