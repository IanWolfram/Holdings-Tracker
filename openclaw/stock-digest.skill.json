{
  "name": "stock-digest",
  "description": "Fetches daily stock news digest and sends summary to Telegram",
  "version": "1.0.0",
  "trigger": {
    "type": "schedule",
    "cron": "0 9 * * 1-5",
    "timezone": "America/New_York"
  },
  "action": {
    "type": "http",
    "method": "POST",
    "url": "${DASHBOARD_URL}/api/digest",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer ${OPENCLAW_DIGEST_SECRET}"
    }
  },
  "on_error": {
    "notify": "telegram",
    "message": "⚠️ Stock digest failed to send. Check dashboard logs."
  }
}
